@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Zadacha1zhd.Models.RentProductModel

<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/rentwindow.css">
        <title>Окно бронирования</title>
    </head>
    <body>

       <header>
            <div class="top-bar">
                <a asp-action="ProductCatalog" asp-controller="RentProductCatalog"><img class="backButton" src="/Images/Кнопка назад.png" alt="кнопка-назад"></a>
                <div class="windows-buttons">
                    <a asp-action="ProductCatalog" asp-controller="RentProductCatalog"><img src="/Images/Каталог.png" alt="catalog-button"></a>
                    <a asp-controller="Profile" asp-action="Profile"><img class="profileButton" src="/Images/Профиль.png" alt="профиль"></a>
                </div>
            </div>
       </header>

       <main>
            <div class="product-layout">
                <div class="product-left-col">

                    <img class="product-img" src="@Model.URLImage" alt="картинка-товара">

                    <form id="rentForm" asp-controller="RentProductCatalog" asp-action="ProductRent" method="post">
                        <input type="hidden" name="productId" value="@Model.Id"/>
                            <div class="product_rent_days-items">
                                <p class="rent_days-label">Выберите срок аренды:</p>
                                <div class="rent-days">
                                    <p class="first_rent_day">
                                        <span class="first_rent_day-label">ОТ</span>
                                        <span>
                                            <input class="first_rent_day-value" type="date" name="startRent" id="startRent"
                                            value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                            min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                            required>
                                        </span>
                                    </p>
                                    <p class="second_rent_day">
                                        <span class="second_rent_day-label">ДО</span>
                                        <span>
                                            <input class="second_rent_day-value" type="date" name="endRent" id="endRent"
                                            value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                            min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                            required>
                                        </span>
                                    </p>
                                </div>
                            </div>
                    </form>

                    <div class="product_price-items"
                        data-price="@Model.PricePerDay.ToString("0")"
                        data-deposit="@Model.Deposit.ToString("0")">
                        <div class="product-price">
                            <p class="product-rent-price">
                                <span class="price-label">Цена аренды в день:</span>
                                <span class="price-value"><span id="price-per-day">@Model.PricePerDay.ToString("N0")</span> ₽</span>
                            </p>
                            <p class="rent-days-amount">
                                <span class="price-label">Количество дней:</span>
                                <span class="price-value"><span id="total-days">1</span></span>
                            </p>
                            <p class="product-deposit">
                                <span class="price-label">Залог:</span>
                                <span class="price-value"><span id="deposit-amount">@Model.Deposit.ToString("N0")</span> ₽</span>
                            </p>
                        </div>
                        <p class="total-rent-sum">
                            <span class="total-price-label">Общая цена аренды:</span>
                            <span class="total-price-value"><span id="total-sum">@((Model.PricePerDay + Model.Deposit).ToString("N0"))</span> ₽</span>
                        </p>
                    </div>
                </div>
                <div class="product-right-col">
                    <div class="product-desc">@Model.Description</div>
                    <div class="product-desc-bottom-decoration"></div>
                </div>
            </div>
       </main>

       <footer>
            <div class="bottom-bar">
                <form asp-controller="RentProductCatalog" asp-action="BookingProduct" method="post">
                <button type="submit" form="rentForm" class="confirm_rent-button">Забронировать</button>
                </form>
            </div>
       </footer>

       <script src="/js/booking.js" asp-append-version="true"></script>
       
    </body>
</html>