@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/profile.css">
    <title>Личный кабинет</title>
</head>
    <body>

        <header>
            <div class="top-bar">

                <div class="windows-buttons">
                    <a asp-controller="RentProductCatalog" asp-action="ProductCatalog"><img src="/Images/Каталог.png" alt="catalog-button"></a>
                </div>
            </div>
        </header>

        <main>
            <div class="main-content">
                <div class="profile-bar">
                    <h1>Профиль</h1>
                    <div class="profile-bar-items">
                        <div class="profile-top-bar">
                            <p class="profile-login">Логин: <span id="login">---</span></p>
                            <button class="profile-exit-button">Выйти с аккаунта</button>
                        </div>

                        <div class="profile-bottom-bar">
                            <p class="profile-full-name">ФИО: <span id="full-name">---</span></p>
                            <p class="profile-email">Email: <span id="email">---</span></p>
                            <p class="profile-phone">Телефон: <span id="phone">---</span></p>
                        
                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <h1>Текущие бронирования</h1>
                    <table class="current-rents-table">
                        <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Даты аренды</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody class="current-rents-body">
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img class="product-img" src="/Images/Велосипед.png" alt="картинка-товара"><span id="product-name">Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый</span>
                                    </div>
                                </td>
                                <td><span id="product-first-rent-day">12.12.12</span> - <span id="product-second-rent-day">14.12.12</span></td>
                                <td><span id="product-rent-price">4000</span></td>
                                <td><span id="product-status">Завершенно</span></td>
                                <td><span id="product-actions"><button>Отменить</button></span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img class="product-img" src="/Images/Велосипед.png" alt="картинка-товара"><span id="product-name">Велосипед жёлтый</span>
                                    </div>
                                </td>
                                <td><span id="product-first-rent-day">12.12.12</span> - <span id="product-second-rent-day">14.12.12</span></td>
                                <td><span id="product-rent-price">4000</span></td>
                                <td><span id="product-status">Завершенно</span></td>
                                <td><span id="product-actions"><button>Отменить</button></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="table-container">
                    <h1>История бронирований</h1>
                    <table class="rents-history-table">
                        <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Даты аренды</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody class="rents-history-body">
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img class="product-img" src="/Images/Велосипед.png" alt="картинка-товара"><span id="product-name">Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый Велосипед жёлтый</span>
                                    </div>
                                </td>
                                <td><span id="product-first-rent-day">6.12.12</span> - <span id="product-second-rent-day">8.12.12</span></td>
                                <td><span id="product-rent-price">4000</span></td>
                                <td><span class="product-status" id="product-status">Возвращено</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img class="product-img" src="/Images/Велосипед.png" alt="картинка-товара"><span id="product-name">Велосипед жёлтый</span>
                                    </div>
                                </td>
                                <td><span id="product-first-rent-day">6.12.12</span> - <span id="product-second-rent-day">8.12.12</span></td>
                                <td><span id="product-rent-price">4000</span></td>
                                <td><span class="product-status" id="product-status">Возвращено</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </body>
</html>