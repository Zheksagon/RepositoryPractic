@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Zadacha1zhd.Models
@model Zadacha1zhd.Models.AuthenticationModel

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/profile.css">
    <title>Личный кабинет</title>
</head>
    <body>

        <header>
            <div class="top-bar">

                <div class="windows-buttons">
                    <a asp-action="ProductCatalog" asp-controller="RentProductCatalog"><img class="backButton" src="/Images/Кнопка назад.png" alt="кнопка-назад"></a>
                    <a asp-controller="RentProductCatalog" asp-action="ProductCatalog"><img src="/Images/Каталог.png" alt="catalog-button"></a>
                </div>
            </div>
        </header>

        <main>
            <div class="main-content">
                <div class="profile-bar">
                    <h1>Профиль</h1>
                    <div class="profile-bar-items">
                        <div class="profile-top-bar">
                            <p class="profile-login">Логин: <span id="login">@Model.Login</span></p>
                            <form asp-action="Logout" asp-controller="Profile" method="post">
                                <button type="submit" class="profile-exit-button">Выйти с аккаунта</button>
                            </form>
                        </div>

                        <div class="profile-bottom-bar">
                            <p class="profile-full-name">ФИО: <span id="full-name">@Model.LastName @Model.FirstName @Model.Patronymic</span></p>
                            @if (Model.Email != null) 
                            {
                            <p class="profile-email">Email: <span id="email">@Model.Email</span></p>
                            }
                            else
                            {
                            <p class="profile-email">Email: <span id="email">Не указан</span></p>
                            }
                            @if (Model.PhoneNumber != null) 
                            {
                            <p class="profile-phone">Телефон: <span id="phone">@Model.PhoneNumber</span></p>
                            }
                            else
                            {
                            <p class="profile-phone">Телефон: <span id="phone">Не указан</span></p>    
                            }

                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <h1>Текущие бронирования</h1>
                    <table class="current-rents-table">
                        <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Даты аренды</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody class="current-rents-body">
                            @if (Model?.Bookings != null)
                            {
                                foreach (var booking in Model.Bookings.Where(b => b.Status != BookingStatus.Returned && b.Status != BookingStatus.Cancelled && b.Status != BookingStatus.CancelledConfirmed))
                                {
                                    <tr>
                                        <td>
                                            <div class="product-cell">
                                                <img class="product-img" src="@booking.Product?.URLImage" alt="@booking.Product?.Title">
                                                <span>@booking.Product?.Title</span>
                                            </div>
                                        </td>
                                        <td>@booking.StartRent.ToString("dd.MM.yyyy") - @booking.EndRent.ToString("dd.MM.yyyy")</td>
                                        <td>@booking.TotalPrice руб.</td>
                                        <td>@booking.Status</td>
                                        <td>
                                            @if (booking.Status == BookingStatus.Confirmed || booking.Status == BookingStatus.Pending)
                                            {
                                                <form asp-controller="Profile" asp-action="CancelBooking" asp-route-id="@booking.Id" method="post">
                                                    <button type="submit">Отменить</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-container">
                    <h1>История бронирований</h1>
                    <table class="rents-history-table">
                        <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Даты аренды</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody class="rents-history-body">
                            @if (Model?.Bookings != null)
                            {
                                foreach (var booking in Model.Bookings.Where(b => b.Status == BookingStatus.CancelledConfirmed || b.Status == BookingStatus.Returned))
                                {
                                    <tr>
                                        <td>
                                            <div class="product-cell">
                                                <img class="product-img" src="@booking.Product?.URLImage" alt="@booking.Product?.Title">
                                                <span>@booking.Product?.Title</span>
                                            </div>
                                        </td>
                                        <td>@booking.StartRent.ToString("dd.MM.yyyy") - @booking.EndRent.ToString("dd.MM.yyyy")</td>
                                        <td>@booking.TotalPrice руб.</td>
                                        @if (booking.Status == BookingStatus.CancelledConfirmed) 
                                        {
                                        <td>Отменено</td>
                                        }
                                        else 
                                        {
                                        <td>@booking.Status</td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </body>
</html>