@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Zadacha1zhd.Models.RentProductModel

<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/catalog.css">
        <title>Окно каталога товаров</title>
    </head>
    <body>

        <header>
            <div class="search-bar-items">
                <input class="search-bar" type="search" name="searchBar" id="searchBar" placeholder="Введите название товара...">
                <button class="search-button">Найти</button>
            </div>
                <a class="profile-icon" asp-controller="Profile" asp-action="Profile"><img src="/Images/Профиль.png" alt="profileIcon"></a> 
        </header>

        <main class="container">

            <a class="product-card" asp-controller="RentProductCatalog" asp-action="ProductRent">
                <img class="card-img" src="/Images/Велосипед.png" alt="Велосипед горный">
                <h3 class="card-desc">Велосипед горный</h3>
                <p class="card-price">От 500 рублей / день</p>
            </a>

        </main>
    </body>
</html>