@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Zadacha1zhd.Models.RentProductModel>

<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/catalog.css" asp-append-version="true">
        <title>Окно каталога товаров</title>
    </head>
    <body>

        <header>
            <form class="search-bar-items" asp-controller="RentProductCatalog" asp-action="ProductCatalog" method="get">
                <select class="category-select" name="categoryId" onchange="this.form.submit()">
                    <option value="">Все категории</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            if (ViewBag.SelectedCategoryId == category.Id)
                            {
                                <option value="@category.Id" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    }
                </select>

                <input class="search-bar" type="search" name="searchBar" id="searchBar" value="@ViewBag.SearchQuery" placeholder="Введите название товара...">
                <button type="submit" class="search-button">Найти</button>
            </form>

            <a class="profile-icon" asp-controller="Profile" asp-action="Profile">
                <img src="/Images/Профиль.png" alt="profileIcon">
            </a>
        </header>

        <main class="container">
            @if (Model != null && Model.Any())
            {
                foreach (var Product in Model)
                {
                    <a class="product-card" asp-controller="RentProductCatalog" asp-action="ProductRent" asp-route-id="@Product.Id">
                        <img class="card-img" src="@Product.URLImage">
                        <h3 class="card-desc">@Product.Title</h3>
                        <p class="card-price">От @Product.PricePerDay.ToString("N0") рублей / день</p>
                    </a>
                }
            }
            else
            {
                <p>Товары не найдены</p>
            }

        </main>
    </body>
</html>