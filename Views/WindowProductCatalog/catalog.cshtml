@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Zadacha1zhd.Models.RentProductModel>

<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/catalog.css">
        <title>Окно каталога товаров</title>
    </head>
    <body>

        <header>
            <div class="search-bar-items">
                <input class="search-bar" type="search" name="searchBar" id="searchBar" placeholder="Введите название товара...">
                <button class="search-button">Найти</button>
            </div>
                <a class="profile-icon" asp-controller="Profile" asp-action="Profile"><img src="/Images/Профиль.png" alt="profileIcon"></a> 
        </header>

        <main class="container">
            @if (Model != null && Model.Any())
            {
                foreach (var Product in Model)
                {
                    <a class="product-card" asp-controller="RentProductCatalog" asp-action="ProductRent" asp-route-id="@Product.Id">
                        <img class="card-img" src="@Product.URLImage">
                        <h3 class="card-desc">@Product.Title</h3>
                        <p class="card-price">От @Product.PricePerDay.ToString("N0") рублей / день</p>
                    </a>
                }
            }
            else
            {
                <p>Товары не найдены</p>
            }

        </main>
    </body>
</html>