@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Zadacha1zhd.Models.AuthenticationModel

<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Окно авторизации пользователя</title>
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/authentication.css">
    </head>
    <body>
        <div class="container">

            <div class="heading-text">АВТОРИЗАЦИЯ (Клиент)</div>

            <div class="error-message" id="error"></div>

            <form id="form" asp-controller="Authentication" asp-action="UserAuthorization" method="post">
                <div class="input-boxes">
                    <div class="input">
                        <p>Логин / Почта / Телефон</p>
                        <input asp-for="LoginEmailPhoneNumber" type="text" id="loginOrEmailOrPhone" required>
                    </div>

                    <div class="input">
                        <p>Пароль</p>
                        <div class="password-wrapper">
                            <input asp-for="Password" type="password" name="Password" id="password" required>
                            <button type="button" class="toggle-password" data-target="password">♦</button>
                        </div>
                    </div>
                </div>

                <div class="button-container">

                    <div class="main-buttons">
                        <button class="confirm-button" type="submit">Авторизоваться</button>
                        <a class="window-changer" asp-controller="Authentication" asp-action="UserRegistration">Создать аккаунт</a>
                    </div>

                    <div class="links-container">
                        <a asp-controller="Authentication" asp-action="UserAuthorization">Клиент</a>
                        <a asp-controller="Authentication" asp-action="ManagerAuthorization">Менеджер</a>
                        <a asp-controller="Authentication" asp-action="AdministratorAuthorization">Администратор</a>
                    </div>

                </div>

            </form>
        </div>

        <script  src="/js/authentication.js" asp-append-version="true"></script>

    </body>
</html>