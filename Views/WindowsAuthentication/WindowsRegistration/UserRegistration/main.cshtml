@model Zadacha1zhd.Models.AuthenticationModel
@addTagHelper *, Microsoft.Asp.Net.Core.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Окно регистрации пользователя</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/user-reg.css">
</head>
    <body>
        <div class="container">
            <div class="heading-text">РЕГИСТРАЦИЯ (Пользователь)</div>
            <div class="input-boxes">
                <div class="input">
                    <p>Логин</p>
                    <input type="text" name="login" id="login">
                </div>
                
                <div class="input">
                    <p>Почта / Телефон</p>
                    <input type="text" name="phoneOrEmail" id="phoneOrEmail">
                </div>
                
                <div class="input">
                    <p>Пароль</p>
                    <div class="password-wrapper">
                        <input type="password" name="password" id="password">
                        <button type="button" class="toggle-password" data-target="password">♦</button>
                    </div>
                </div>
                
                <div class="input">
                    <p>Повтор пароля</p>
                    <div class="password-wrapper">
                        <input type="password" name="passwordRepeat" id="passwordRepeat">
                        <button type="button" class="toggle-password" data-target="passwordRepeat">♦</button>
                    </div>
                </div>
            </div>
            <div class="confirm-buttons">
                <button class="regButton" type="submit">Зарегистрироваться</button>

                @* Ссылки на другие страницы регистрации и авторизации (пока что костыльные)*@
                <a href="empty">Зарегистрироваться за менеджера</a>
                <a href="empty">Зарегистрироваться за администратора</a>
                <a href="empty">Войти в аккаунт за пользователя</a>
                <a href="empty">Войти в аккаунт за менеджера</a>
                <a href="empty">Войти в аккаунт за администратора</a>
            </div>
            </div>
        </div>

        <script>
            document.querySelectorAll('.toggle-password').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.target);
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    button.textContent = isPassword ? '•' : '♦';
                    button.setAttribute('aria-label', isPassword ? 'Скрыть пароль' : 'Показать пароль');
                });
            });
        </script>

    </body>
</html>