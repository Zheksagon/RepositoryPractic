@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Zadacha1zhd.Models.AuthenticationModel

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Окно регистрации администратора</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/Authentication/admin-reg.css">
</head>
    <body>
        <div class="container">
            <div class="heading-text">РЕГИСТРАЦИЯ (Администратор)</div>
             
            <div id="error" style="color: #ff6b6b; text-align: center; margin-top: 5px" @*class="Добавь сюда класс в css"*@></div>

            <form id="form" asp-controller="Authentication" asp-action="AdministratorRegistration" method="post">
                <div class="input-boxes">

                   <div class="input">
                        <p>Имя</p>
                        <input asp-for="FirstName" type="text" id="firstName" name="FirstName" required>
                    </div>
                
                    <div class="input">
                        <p>Фамилия</p>
                        <input asp-for="LastName" type="text" id="lastName" name="LastName" required>
                    </div>
                
                    <div class="input">
                        <p>Отчество</p>
                        <input asp-for="Patronymic" type="text" id="patronymic" name="Patronymic" required>
                    </div>
                
                    <div class="input">
                        <p>Логин</p>
                        <input asp-for="Login" type="text" id="login" name="Login" required>
                    </div>
                        
                    <div class="input">
                        <p>Почта / Телефон</p>
                        <input asp-for="PhoneNumberEmail" type="text" id="phoneOrEmail" required>
                    </div>
                        
                    <div class="input">
                        <p>Пароль</p>
                        <div class="password-wrapper">
                            <input asp-for="Password" type="password" id="password" name="Password" required>
                            <button type="button" class="toggle-password" data-target="password">♦</button>
                        </div>
                    </div>
                        
                    <div class="input">
                        <p>Повтор пароля</p>
                        <div class="password-wrapper">
                            <input type="password" id="passwordRepeat" name="passwordRepeat" required>
                            <button type="button" class="toggle-password" data-target="passwordRepeat">♦</button>
                        </div>
                    </div>

                    <div class="input">
                        <p>PIN-код</p>
                        <input  asp-for="PINcode"
                                type="text"
                                inputmode="numeric"
                                pattern="[0-9]*"
                                maxlength="4"
                                autocomplete="one-time-code"
                                id="pin"
                                required>
                    </div>
                
                </div>
                <div class="confirm-buttons">
                    <button class="regButton" type="submit">Зарегистрироваться</button>

                    @* Ссылки на другие страницы регистрации и авторизации (пока что костыльные)*@
                    <a asp-controller="Authentication" asp-action="Authentication">На главную (регистрация пользователя)</a>
                    <a asp-controller="Authentication" asp-action="AdministratorRegistration">Зарегистрироваться за администратора</a>
                    <a asp-controller="Authentication" asp-action="UserAuthorization">Войти в аккаунт за пользователя</a>
                    <a asp-controller="Authentication" asp-action="ManagerAuthorization">Войти в аккаунт за менеджера</a>
                    <a asp-controller="Authentication" asp-action="AdministratorAuthorization">Войти в аккаунт за администратора</a>
                </div>
            </form>
        </div>

        <script src="/js/Authentication/Authentication.js" asp-append-version="true"></script>

    </body>
</html>