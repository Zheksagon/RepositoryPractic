@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Zadacha1zhd.Models.AuthenticationModel

<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Окно регистрации пользователя</title>
        <link rel="stylesheet" href="/css/reset.css">
        <link rel="stylesheet" href="/css/Authentication/authentication.css">
    </head>
    <body>
        <div class="container">
            <div class="heading-text">РЕГИСТРАЦИЯ (Пользователь)</div>

            <div class="error-message" id="error"></div>

            <form id="form" asp-controller="Authentication" asp-action="MainAuthentication" method="post">
                <div class="input-boxes">

                    <div class="input">
                        <p>Имя</p>
                        <input asp-for="FirstName" type="text" id="firstName" name="FirstName" required>
                    </div>
                
                    <div class="input">
                        <p>Фамилия</p>
                        <input asp-for="LastName" type="text" id="lastName" name="LastName" required>
                    </div>
                
                    <div class="input">
                        <p>Отчество</p>
                        <input asp-for="Patronymic" type="text" id="patronymic" name="Patronymic" required>
                    </div>
                
                    <div class="input">
                        <p>Логин</p>
                        <input asp-for="Login" type="text" id="login" name="Login" required>
                    </div>
                        
                    <div class="input">
                        <p>Почта / Телефон</p>
                        <input asp-for="PhoneNumberEmail" type="text" id="phoneOrEmail" required>
                    </div>
                        
                    <div class="input">
                        <p>Пароль</p>
                        <div class="password-wrapper">
                            <input asp-for="Password" type="password" id="password" name="Password" required>
                            <button type="button" class="toggle-password" data-target="password">♦</button>
                        </div>
                    </div>
                        
                    <div class="input">
                        <p>Повтор пароля</p>
                        <div class="password-wrapper">
                            <input type="password" id="passwordRepeat" name="PasswordRepeat" required>
                            <button type="button" class="toggle-password" data-target="passwordRepeat">♦</button>
                        </div>
                    </div>
                </div>
            </form>
            <div class="confirm-buttons">
                <button class="regButton" type="submit">Зарегистрироваться</button>

                <a class="window-changer" asp-controller="Authentication" asp-action="UserAuthorization">Войти в аккаунт</a>

                <div class="links-container">
                    <a asp-controller="Authentication" asp-action="Authentication">Пользователь</a>
                    <a asp-controller="Authentication" asp-action="ManagerRegistration">Менеджер</a>
                    <a asp-controller="Authentication" asp-action="AdministratorRegistration">Администратор</a>
                </div>
            </div>
        </div>

        <script src="/js/Authentication/Authentication.js" asp-append-version="true"></script>

    </body>
</html>